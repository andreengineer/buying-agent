{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/scorecard.schema.json",
  "title": "Scorecard",
  "description": "Weighted evaluation of all Offers for one Request (AC-3, AC-4, AC-5). Weights sum to 1.0 (checked in code, not schema). reference_landed_cost_brl = median landed cost of offers with assurance.passed = true.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "profile", "weights", "rows", "reference_landed_cost_brl", "generated_at"],
  "properties": {
    "request_id": { "type": "string" },
    "profile": { "enum": ["durables_v1", "electronics_v1", "pharmacy_v1"] },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality", "value", "assurance", "popularity", "delivery", "warranty"],
      "properties": {
        "quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "assurance": { "type": "number", "minimum": 0, "maximum": 1 },
        "popularity": { "type": "number", "minimum": 0, "maximum": 1 },
        "delivery": { "type": "number", "minimum": 0, "maximum": 1 },
        "warranty": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["offer_id", "scores", "total", "rank", "excluded", "why"],
        "properties": {
          "offer_id": { "type": "string" },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": ["quality", "value", "assurance", "popularity", "delivery", "warranty"],
            "properties": {
              "quality": { "type": "number", "minimum": 0, "maximum": 10 },
              "value": { "type": "number", "minimum": 0, "maximum": 10 },
              "assurance": { "type": "number", "minimum": 0, "maximum": 10 },
              "popularity": { "type": "number", "minimum": 0, "maximum": 10 },
              "delivery": { "type": "number", "minimum": 0, "maximum": 10 },
              "warranty": { "type": "number", "minimum": 0, "maximum": 10 }
            }
          },
          "total": { "type": "number", "minimum": 0, "maximum": 10 },
          "rank": { "type": ["integer", "null"], "minimum": 1 },
          "excluded": { "type": "boolean" },
          "exclusion_reason": { "type": ["string", "null"] },
          "why": { "type": "string", "maxLength": 120 }
        }
      }
    },
    "reference_landed_cost_brl": { "type": "number", "minimum": 0 },
    "savings_vs_reference_brl": { "type": "number" },
    "offers_found": { "type": "integer", "minimum": 0 },
    "sources_used": { "type": "integer", "minimum": 0 },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
